# Copy to .env and fill in. Load into your shell before running the server,
# e.g. `export $(grep -v '^#' .env | xargs)` or use a tool like dotenv/direnv.

# Which LLM provider to use: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# --- Gemini (default provider) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Note: gemini-2.5-pro / gemini-2.5-flash are retired for new API users.
# Use current models: gemini-flash-lite-latest, gemini-flash-latest, or
# gemini-pro-latest (Pro has a small free-tier daily quota).
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenAI (only needed if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Redis for Sidekiq
REDIS_URL=redis://localhost:6379/0

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
